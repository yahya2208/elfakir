# متغيرات بيئة تطبيق El Fakir (الفقير)
# نسخة مثال — لا تحتوي على أسرار حقيقية.
# انسخ هذا الملف إلى .env المحلي وقم بتعبئة القيم الفعلية عند الحاجة.

# Supabase (مشروع مستقل — لا تستخدم مفاتيح FOCUS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-only

#'application settings
VITE_APP_NAME=ar:الفقير / lat:El Fakir
VITE_APP_LOCALE=ar
# DZD — قرار معتمد سابقًا؛ MAD في نسخة قديمة من هذا الملف كان خطأً
VITE_APP_CURRENCY=DZD

# الدفع (يُحدد لاحقًا حسب قرار صاحب المشروع)
# VITE_PAYMENT_PROVIDER=cash_on_delivery
# VITE_PAYMENT_PUBLIC_KEY=...

# التحليلات (اختياري)
# VITE_TELEMETRY_ENDPOINT=

# لا تضع Service Role Key أبدًا في متغيرات متصفح (VITE_*)
# Service Role Key تُستخدم فقط في Supabase Edge Functions / الخادم
